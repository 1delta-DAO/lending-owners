# Per-lender subgraph API keys. Copy to .env and fill in.
AAVE_V3_SUBGRAPH_API_KEY=
COMPOUND_V3_SUBGRAPH_API_KEY=
SILO_SUBGRAPH_API_KEY=
SPARK_SUBGRAPH_API_KEY=
VENUS_SUBGRAPH_API_KEY=
DFORCE_SUBGRAPH_API_KEY=
MOONWELL_SUBGRAPH_API_KEY=
# Euler, Aave v4 and Morpho Blue do not need keys
# (Morpho Blue reads Morpho's own API at blue-api.morpho.org)
